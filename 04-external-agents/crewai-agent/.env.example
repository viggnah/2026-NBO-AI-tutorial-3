# --- The agent itself ----------------------------------------------------
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
PORT=8000

# --- Agent Manager -------------------------------------------------------
# Both values come from the console after registering this agent as an
# Externally-Hosted Agent: the Setup Agent panel shows the OTel endpoint and
# mints the API key. See this module's README, step 2.
#
# Paste AMP_OTEL_ENDPOINT exactly as the console gives it. Both the base URL
# and one already ending in /v1/traces work - the signal path is appended
# only when it is absent.
AMP_OTEL_ENDPOINT=
AMP_AGENT_API_KEY=

# --- Routing model calls through Agent Manager (optional) ----------------
# Set these two and every model call goes through the platform's LLM gateway
# instead of straight to the provider: central rate limits, access control
# and guardrails, and the provider's real credential never reaches this
# process. Both come from the console: Configure -> Add LLM Configuration ->
# Connect to LLM Provider.
#
#   OPENAI_BASE_URL=<the Endpoint URL that panel shows>
#   LLM_GATEWAY_API_KEY=<the API Key it shows once>
#
# Comment OPENAI_API_KEY out when you do. The agent ignores it in gateway
# mode anyway, but leaving a live provider key in a file it no longer needs
# is the habit this whole setup exists to break.
LLM_GATEWAY_API_KEY=
# LLM_GATEWAY_HEADER=API-Key     # only if your gateway names it differently

# --- Optional ------------------------------------------------------------
# Talk to anything that speaks the OpenAI API instead of OpenAI itself -
# Groq, vLLM, an Agent Manager LLM Service Provider. Set OPENAI_MODEL to the
# id that provider publishes; it is qualified as an OpenAI-API model for you.
#
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   OPENAI_MODEL=openai/gpt-oss-120b
#
# The OTLP exporter gives up on a batch after 10 seconds by default, which
# is thin over conference wifi. Seconds, standard OpenTelemetry variable.
OTEL_EXPORTER_OTLP_TIMEOUT=30
#
# CREW_VERBOSE=1        # print each crew step to the console
